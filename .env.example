# PostgreSQL connection string (required)
DATABASE_URL=postgresql://username:password@localhost:5432/resume_builder

# Session signing secret (required outside tests; minimum 32 characters)
SESSION_SECRET=

# Server port (optional, default: 5000)
PORT=5000

# Environment: development, production, or test (optional, default: development)
NODE_ENV=development

# Trusted reverse-proxy hops (0 by default; set 1 only behind one controlled proxy)
# Proxy must preserve Host and set X-Forwarded-Proto. Block direct public Node access.
TRUST_PROXY_HOPS=0
